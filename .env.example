# Local secrets - not committed. Same Neon database and bucket as data-cleaning-smbo.
#
# Stage 01 reads the warehouse. Configure libpq with either DATABASE_URL or PG*:
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
PGHOST=
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require
PGCHANNELBINDING=require

# The DVC remote "neon" is s3:// on Neon object storage (see .dvc/config).
# `make dvc-push` / `make dvc-pull` and load_model() need these.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Optional model loader overrides (resolution_classifier.model):
# RESOLUTION_MODEL=   pin a local joblib and skip the DVC download
# RESOLUTION_REV=     git branch, tag, or commit for the DVC download
# RESOLUTION_REPO=    git repo dvc.api clones (defaults to this repo)
# RESOLUTION_CACHE=   directory for the md5 joblib cache
